# Gradle 缓存与构建产物（无需提交）
.gradle/
build/

# IntelliJ IDEA / Android Studio（环境相关）
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse（环境相关）
.classpath
.project
.settings/
bin/

# macOS 系统文件
.DS_Store

# 运行目录（开发环境用）
run/

# 日志 / 锁文件
*.log
*.lock

# VSCode 配置（通常为个人偏好，GTNH 仓库一般不提交）
.vscode/

# 说明：
# - 若 libs/ 中包含「必须随仓库分发」的依赖 JAR，请不要忽略，保持提交。
# - 若日后改为仅放构建产物，可酌情在此添加：libs/
